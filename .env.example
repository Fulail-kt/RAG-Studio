# ── Gemini API ─────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model names ────────────────────────────────────────────────────────────────
# Main model used for chat responses
GEMINI_MODEL_NAME=gemini-2.0-flash

# Used for routing decisions (which KB source to use). Lighter = faster.
DECISION_MODEL_NAME=gemini-2.0-flash-lite

# Reserved for lightweight tasks (optional, falls back to GEMINI_MODEL_NAME)
SMALL_MODEL_NAME=gemini-2.0-flash-lite

# ── Knowledge base freshness ───────────────────────────────────────────────────
# Days before a scraped URL is considered stale and re-fetched
SCRAPE_MAX_AGE_DAYS=7
